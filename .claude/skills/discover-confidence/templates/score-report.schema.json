{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/discover-confidence-score-report.v1.json",
  "title": "Discover-Confidence Score Report",
  "description": "Output schema for /discover-confidence M2 structural scoring of an opportunity.",
  "type": "object",
  "required": [
    "opportunity_slug",
    "opportunity_path",
    "scored_at",
    "corner_coverage_score",
    "evidence_pointers_score",
    "opportunity_completeness_score",
    "structural_risk_score",
    "active_dimensions",
    "weight_normalization_factor",
    "weighted_avg",
    "hard_caps_triggered",
    "final_score_after_caps",
    "verdict"
  ],
  "properties": {
    "opportunity_slug": {
      "type": "string"
    },
    "opportunity_path": {
      "type": "string"
    },
    "scored_at": {
      "type": "string",
      "format": "date-time"
    },
    "corner_coverage_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "evidence_pointers_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "opportunity_completeness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "structural_risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "active_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "corner_coverage",
          "evidence_pointers",
          "opportunity_completeness",
          "structural_risk"
        ]
      }
    },
    "weight_normalization_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "weighted_avg": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "hard_caps_triggered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_score_after_caps": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "type": "string",
      "enum": [
        "SHIPPABLE",
        "SHIPPABLE_WITH_CAVEATS",
        "NON_SHIPPABLE",
        "INVALID"
      ]
    },
    "calibration": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "holdout_count": {
          "type": "integer",
          "minimum": 0
        },
        "holdout_target": {
          "type": "integer",
          "minimum": 0
        },
        "kappa_measured": {
          "type": "boolean"
        }
      }
    },
    "reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "contributors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detractors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sub_reports": {
      "type": "object"
    }
  }
}
