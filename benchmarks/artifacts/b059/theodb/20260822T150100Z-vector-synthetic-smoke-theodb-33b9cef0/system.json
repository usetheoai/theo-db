{
  "schema_version": 1,
  "system": "theodb",
  "capabilities": {
    "vector_exact": true,
    "vector_hnsw": true,
    "vector_ivfflat": true,
    "vector_scann": false,
    "vector_quantized": true,
    "vector_filtered": true,
    "lexical": true,
    "hybrid": true,
    "rerank": false,
    "columnar": true,
    "parquet": true,
    "graph": true,
    "vectorizer": false,
    "ai_sql": false
  },
  "version": "PostgreSQL 18.6 (Debian 18.6-1.pgdg12+2) / theodb_rs 1.5.0",
  "effective_configuration": {
    "shared_buffers": "16GB",
    "work_mem": "256MB",
    "maintenance_work_mem": "8GB",
    "max_connections": "100",
    "max_parallel_workers": "8",
    "max_parallel_workers_per_gather": "2",
    "effective_cache_size": "4GB",
    "synchronous_commit": "on",
    "fsync": "on",
    "full_page_writes": "on",
    "wal_level": "replica",
    "checkpoint_timeout": "5min",
    "random_page_cost": "4",
    "jit": "on"
  },
  "durability": {
    "synchronous_commit": "on",
    "fsync": "on"
  }
}
