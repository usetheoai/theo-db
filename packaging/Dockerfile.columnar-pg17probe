# THROWAWAY de-risk probe: build pg_mooncake --pg17 on top of the prebuilt pg_duckdb PG17 base.
# Goal: obtain PG17 functional evidence for M6 (columnar/HTAP). pg_mooncake supports pg17 (its Makefile),
# but publishes no pg17 release artifact, so it must be compiled (Rust + cargo-pgrx + duckdb_mooncake submodule).
# This is a de-risk probe, NOT a shipped image. If the compile is infeasible, M6 falls back to measuring the
# columnar capability on the canonical pg_mooncake distribution (measurement-first, cf. BM25 S2).
FROM pgduckdb/pgduckdb:17-main AS build
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl gcc g++ make pkg-config git ninja-build postgresql-server-dev-17 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"
RUN cargo install --locked cargo-pgrx@0.16.1 \
 && cargo pgrx init --pg17=$(which pg_config)
RUN git clone --recurse-submodules --depth 1 https://github.com/Mooncake-Labs/pg_mooncake /pgmc
WORKDIR /pgmc
RUN PG_VERSION=pg17 make package
