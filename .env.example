# TheoDB local secrets — copy to .env and fill in. .env is gitignored; NEVER commit real keys.
# Used by the embedding paths (theodb.embed remote / tools/embedding_server alternatives) and tooling.

# OpenAI-compatible embeddings (cloud path of theodb.embed — M2 DoD-3)
OPENAI_API_KEY=sk-...
THEODB_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
THEODB_EMBEDDING_MODEL=text-embedding-3-small
