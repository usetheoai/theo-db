# Cycle kit (.claude/) — Python bytecode + tool caches generated by validators/tests
.claude/**/__pycache__/
.claude/**/*.pyc
.claude/**/.pytest_cache/
.claude/**/.ruff_cache/
.claude/**/.mypy_cache/

# Cycle runtime artifacts (regenerated per run; not source)
.claude/knowledge-base/implementations/.progress-*.json
# Per-run halt-loop scaffolding — ephemeral, never tracked (implement SKILL.md: "gitignored").
# The durable summaries ({slug}-implementation.md, {slug}-followups.md) ARE tracked; only the
# per-iteration log dirs + SEPA scaffolding + validate reports are excluded.
halt-loop-prompts/
agents/
.claude/knowledge-base/implementations/*/
.claude/skills/*-sepa-knowledge/
.claude/knowledge-base/reviews/*-implement-validate-*.md

# SOTA reference peers cloned by /roadmap-init — local study material (640M+),
# reproducible via the clone commands in references-catalog.md. Not project source.
.claude/knowledge-base/references/*/

# Compaction snapshots written by precompact-preserve.sh (runtime artifacts)
.claude/.compaction-snapshots/

# Python bytecode (global)
__pycache__/
*.pyc

# Coverage + pytest artifacts
.coverage
.pytest_cache/
.ruff_cache/

# ANN-Benchmarks dataset cache (large HDF5, fetched on demand)
benchmarks/.datasets/

# pytest-benchmark run artifacts (não versionar)
benchmarks/.benchmarks/

# Secrets — local env (API keys). NEVER commit. .env.example (no secrets) IS tracked.
.env
.env.*
!.env.example

# M15: generated extension install script (built from sql/NN-*.sql)
sql/theodb--1.0.sql
dist/
theodb_rs/target/
system-design-output/
architecture-output/
benchmarks/.cache/
benchmarks/benchmarks/

# Top-level reference clones (3rd-party, reproducible via clone commands — not project source)
knowledge-base/references/*/

# M99 isolation harness scratch output (expected/ is committed; results/ is generated)
theodb_rs/isolation/results/
theodb_rs/isolation/tmp_check/

# loop-check-licence local artifacts
.claude/check-licence-evidence.db
.claude/check-licence-loop.local.md
code-review-output/

# review-cycle plugin — estado de loop e artefatos por-execução (regenerados a cada run).
# O relatório consolidado e o arquivo de review são versionados em knowledge-base/; estes NÃO.
.review-runs/
.review-loop/
.compaction-snapshots/
